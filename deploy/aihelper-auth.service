[Unit]
Description=AI Helper Better Auth service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/aihelper/auth
EnvironmentFile=/opt/aihelper/.env
ExecStart=/usr/bin/node /opt/aihelper/auth/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aihelper/auth

[Install]
WantedBy=multi-user.target
