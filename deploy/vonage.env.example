# Vonage account credentials (API settings in the Vonage dashboard)
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Voice application ID and the Vonage number in E.164 format.
VONAGE_APPLICATION_ID=
VONAGE_PHONE_NUMBER=
# Store the downloaded Vonage private key outside the repository, readable only by www-data.
VONAGE_PRIVATE_KEY_PATH=/opt/aihelper/secrets/vonage-private.key
# Generate with: openssl rand -hex 32
VONAGE_WEBHOOK_SECRET=
