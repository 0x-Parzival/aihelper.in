# Copy these entries into /opt/aihelper/.env. Do not commit real values.
PUBLIC_BASE_URL=https://aihelper.in
TELNYX_API_KEY=
# Your Telnyx account UUID (Account SID in the TeXML API).
TELNYX_ACCOUNT_SID=
# The TeXML Application ID to which the international phone number is assigned.
TELNYX_TEXML_APPLICATION_SID=
TELNYX_PHONE_NUMBER=
# Ed25519 public key from Mission Control, as hex (or base64), for webhook verification.
TELNYX_PUBLIC_KEY=

# Transparent, configurable sales-campaign wording for outbound calls.
# The agent always identifies itself as an AI assistant and the represented business.
SALES_AGENT_NAME=Ava
SALES_PROCESS=help businesses respond to customer calls
SALES_MECHANISM=an AI voice agent
SALES_OUTCOME=so fewer qualified opportunities are missed
# Optional. Use only an authorized, business-relevant ICP; never add sensitive
# personal attributes (age, salary, health, ethnicity, or inferred interests).
SALES_IDEAL_CUSTOMER_PROFILE=
# Optional factual proof the agent may cite. Do not add unsupported claims.
SALES_VALUE_EVIDENCE=
# Set to 0 only to disable the carefully gated live-listener acknowledgement.
ACTIVE_LISTENING_ENABLED=1
